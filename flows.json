  {
    "id": "fn",
    "type": "function",
    "z": "tab",
    "name": "Validate, split nodes, alert",
    "func": "const key = env.get(\"NODE_RED_API_KEY\") || \"\";\nconst got = msg.req?.headers?.[\"x-api-key\"];\nif (!key || got !== key) {\n  msg.statusCode = 401; msg.payload = {ok:false,error:\"Unauthorized\"};\n  return [null,null,null,null,null,null,null,null,null,msg];\n}\nlet d = msg.payload;\nif (typeof d === \"string\") { try { d = JSON.parse(d); } catch(e) {\n  msg.statusCode=400; msg.payload={ok:false,error:\"Invalid JSON\"};\n  return [null,null,null,null,null,null,null,null,null,msg];\n}}\nif (!d || ![\"node1\",\"node2\"].includes(d.nodeId)) {\n  msg.statusCode=400; msg.payload={ok:false,error:\"nodeId must be node1 or node2\"};\n  return [null,null,null,null,null,null,null,null,null,msg];\n}\nconst t=Number(d.temperature), h=Number(d.humidity), s=Number(d.smoke_level);\nif (![t,h,s].every(Number.isFinite)) {\n  msg.statusCode=400; msg.payload={ok:false,error:\"Invalid sensor values\"};\n  return [null,null,null,null,null,null,null,null,null,msg];\n}\nconst alert=d.fire_detected===true || t>=50 || h<=20 || s>=600;\nconst id=d.nodeId, old=flow.get(id)||{};\nflow.set(id,{temperature:t,humidity:h,smoke_level:s,alert,lastSeen:Date.now()});\nconst a=flow.get(\"node1\")||{}, b=flow.get(\"node2\")||{};\nfunction val(o,k,suffix=\"\"){return o[k]===undefined?\"รอข้อมูล\":String(o[k])+suffix;}\nfunction stat(o){if(!o.lastSeen)return \"รอข้อมูล\"; if(Date.now()-o.lastSeen>15000)return \"OFFLINE\"; return o.alert?\"ALERT: ตรวจสอบพื้นที่\":\"NORMAL\";}\nfunction m(payload){return {payload};}\nlet tg=null;\nif(alert && old.alert!==true){\n  const token=env.get(\"TELEGRAM_BOT_TOKEN\")||\"\", chat=env.get(\"TELEGRAM_CHAT_ID\")||\"\";\n  if(token && chat) tg={method:\"POST\",url:\"https://api.telegram.org/bot\"+token+\"/sendMessage\",\n    headers:{\"content-type\":\"application/json\"},\n    payload:{chat_id:chat,text:\"🔥 แจ้งเตือนระบบตรวจจับไฟป่า\\\\nNode: \"+id+\"\\\\nอุณหภูมิ: \"+t+\" °C\\\\nความชื้น: \"+h+\" %\\\\nระดับควัน (ADC): \"+s+\"\\\\nกรุณาตรวจสอบพื้นที่\"}};\n  else node.warn(\"Telegram settings missing in .env\");\n}\nreturn [m(val(a,\"temperature\",\" °C\")),m(val(a,\"humidity\",\" %\")),m(val(a,\"smoke_level\")),m(stat(a)),\n        m(val(b,\"temperature\",\" °C\")),m(val(b,\"humidity\",\" %\")),m(val(b,\"smoke_level\")),m(stat(b)),tg,\n        {statusCode:200,payload:{ok:true,nodeId:id}}];",
    "outputs": 10,
    "timeout": 0,
    "noerr": 0,
